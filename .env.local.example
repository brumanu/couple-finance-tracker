# Copie este arquivo para .env.local e preencha com os valores do seu projeto Supabase.
# Encontre em: https://supabase.com/dashboard/project/_/settings/api

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Service role key (bypassa RLS) — usada só pela rota de cron, sem sessão de usuário.
# Encontre em: https://supabase.com/dashboard/project/_/settings/api
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Lembretes de vencimento via Web Push. Gere o par de chaves com:
# npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:seu-email@example.com

# Segredo compartilhado com o cron do Vercel (header Authorization: Bearer <valor>)
CRON_SECRET=
